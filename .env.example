PORT=3000

# Opcional: use MYSQL_URL em provedores como Railway/Aiven/TiDB.
# Para Railway localmente, prefira MYSQL_PUBLIC_URL quando existir.
# Se MYSQL_PUBLIC_URL ou MYSQL_URL estiver preenchida, as variaveis DB_* abaixo sao ignoradas.
MYSQL_PUBLIC_URL=
MYSQL_URL=
DB_SSL=false
DB_SSL_MODE=
DB_SSL_REJECT_UNAUTHORIZED=true
MYSQL_SSL_CA=
MYSQL_SSL_CA_FILE=

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=beehive
DB_PORT=3306
JWT_SECRET=beehive_segredo_123

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WebRTC. TURN e recomendado para chamadas entre redes diferentes.
# Separe varios enderecos TURN por virgula.
STUN_URL=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
